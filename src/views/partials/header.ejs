<%
    const hasSession = typeof session !== 'undefined' && !!session;
    const initials = hasSession && session.user.name ? session.user.name.trim().charAt(0).toUpperCase() : '?';
%>
<header class="app-header">
    <div class="app-header-inner">
        <a class="brand" href="/" aria-label="Ke beranda">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="5" width="16" height="14" rx="3.5" />
                    <path d="M8.2 12.4l2.6 2.6 5-5" />
                </svg>
            </span>
            <span class="brand-text">
                <span class="brand-name">Rencana</span>
                <span class="brand-date"><%= today %></span>
            </span>
        </a>

        <nav class="app-header-actions" aria-label="Navigasi utama">
            <% if (hasSession) { %>
                <a class="nav-avatar" href="/account" title="Akun & keamanan" aria-label="Buka pengaturan akun dan keamanan"><%= initials %></a>

                <a class="nav-add" href="/add-todo" aria-label="Tambah rencana baru">
                    <span class="btn-label">Tambah</span>
                    <span class="btn-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </span>
                </a>

                <span class="nav-divider" aria-hidden="true"></span>

                <button type="button" class="nav-icon" id="theme-toggle" aria-label="Ganti tema terang atau gelap" aria-pressed="false">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
                    </svg>
                </button>

                <form class="nav-logout" method="post" action="/logout">
                    <button type="submit" class="nav-icon" title="Keluar" aria-label="Keluar dari akun">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
                        </svg>
                    </button>
                </form>
            <% } else { %>
                <a class="nav-link" href="/login">Masuk</a>
                <a class="nav-link nav-link-solid" href="/register">Daftar</a>

                <span class="nav-divider" aria-hidden="true"></span>

                <button type="button" class="nav-icon" id="theme-toggle" aria-label="Ganti tema terang atau gelap" aria-pressed="false">
                    <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                    <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" />
                    </svg>
                </button>
            <% } %>
        </nav>
    </div>
</header>