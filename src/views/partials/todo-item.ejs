<div class="todo-item <%= todo.completed ? 'is-done' : '' %>" data-id="<%= todo.id %>"
     data-priority="<%= todo.priority || '' %>" data-due="<%= todo.due || '' %>">
    <form class="toggle-form" method="post" action="/toggle/<%= todo.id %>" aria-label="Ubah status rencana">
        <button type="submit"
                class="todo-check"
                role="checkbox"
                aria-checked="<%= todo.completed ? 'true' : 'false' %>"
                aria-label="<%= todo.completed ? 'Tandai belum selesai' : 'Tandai selesai' %>: <%= todo.name %>">
            <svg class="todo-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5.5 12.8l4 4 9-9" />
            </svg>
        </button>
    </form>

    <div class="todo-body">
        <p class="todo-name"><%= todo.name %></p>
        <% if (todo.priority || todo.due) { %>
        <div class="todo-tags">
            <% if (todo.priority) { %>
            <span class="badge badge-priority badge-priority-<%= todo.priority %>"><%= { low: 'Rendah', medium: 'Sedang', high: 'Tinggi' }[todo.priority] %></span>
            <% } %>
            <% if (todo.due) { const d = fmtDue(todo.due, todo.completed); %>
            <span class="badge badge-due <%= d.state %>"><%= d.label %></span>
            <% } %>
        </div>
        <% } %>
        <span class="todo-meta">Dibuat <%= fmtShort(todo.createdAt) %></span>
    </div>

    <div class="todo-actions">
        <a class="icon-btn" href="/edit-todo/<%= todo.id %>" title="Ubah" aria-label="Ubah rencana: <%= todo.name %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
            </svg>
        </a>
        <form class="delete-form" method="post" action="/?_method=DELETE" data-name="<%= todo.name %>">
            <input type="hidden" name="id" value="<%= todo.id %>">
            <button type="submit" class="icon-btn icon-btn-danger" title="Hapus" aria-label="Hapus rencana: <%= todo.name %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M10 11v6M14 11v6" />
                </svg>
            </button>
        </form>
    </div>
</div>