<footer class="app-footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <span class="brand-mark footer-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="5" width="16" height="14" rx="3.5" />
                    <path d="M8.2 12.4l2.6 2.6 5-5" />
                </svg>
            </span>
            <div class="footer-brand-text">
                <p class="footer-name">Rencana</p>
                <p class="footer-tagline">Buku rencana harian — catat, selesaikan, dan rayakan langkah kecilmu, semua tersimpan aman di akunmu.</p>
            </div>
        </div>

        <nav class="footer-links" aria-label="Navigasi footer">
            <a href="/">Beranda</a>
            <% if (typeof session !== 'undefined' && session) { %>
                <a href="/account">Akun &amp; keamanan</a>
            <% } else { %>
                <a href="/login">Masuk</a>
                <a href="/register">Daftar</a>
            <% } %>
        </nav>
    </div>

    <p class="footer-meta">© <%= new Date().getFullYear() %> Rencana · dibangun dengan Node.js, Express, dan MongoDB · rencanamu tetap aman di akunmu.</p>
</footer>