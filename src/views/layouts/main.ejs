<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= description %>">
    <meta name="author" content="Rencana">
    <meta name="keywords" content="rencana, todo, tugas, daftar, produktivitas">
    <meta name="robots" content="<%= robots %>">
    <meta name="referrer" content="strict-origin-when-cross-origin">

    <!-- OpenGraph (467, 491, 503, 507, 511, 513–515) -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= appName %>">
    <meta property="og:locale" content="id_ID">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= canonical %>">
    <meta property="og:image" content="<%= ogImage %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Pratinjau Rencana — buku rencana harian">

    <!-- Twitter Card (468, 502) -->
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= ogImage %>">

    <meta name="theme-color" content="#f8fafc">
    <meta name="theme-color" content="#0f0f12" media="(prefers-color-scheme: dark)">
    <meta name="format-detection" content="telephone=no">

    <title><%= title %></title>

    <link rel="canonical" href="<%= canonical %>">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='7' fill='%230f172a'/%3E%3Cpath d='M7 12.5l3.2 3.2 6.6-6.6' fill='none' stroke='%23f8fafc' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <script nonce="<%= cspNonce %>">
        (() => {
            document.documentElement.classList.add('js');
            try {
                const stored = localStorage.getItem('theme');
                const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.dataset.theme = stored || system;
            } catch (error) {
                /* don't fail rendering when localStorage is blocked */
            }
        })();
    </script>

<link rel="preload" as="font" type="font/woff2" href="/fonts/geist-latin-wght-normal.woff2">

    <!-- 164 — critical inline background: prevent white flash in dark mode before CSS loads -->
    <style>
        html {
            background: #f8fafc;
        }
        html[data-theme="dark"] {
            background: #0f0f12;
        }
    </style>

    <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
</head>

<body>
    <a class="skip-link" href="#main-content">Lewati ke konten</a>
    <div class="app-shell">
        <%- body %>
    </div>

    <!-- JSON-LD WebSite + WebApplication (476, 519) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "WebSite",
                "name": "<%= appName %>",
                "inLanguage": "id-ID",
                "url": "<%= siteUrl %>"
            },
            {
                "@type": "WebApplication",
                "name": "<%= appName %>",
                "applicationCategory": "ProductivityApplication",
                "operatingSystem": "Web",
                "inLanguage": "id-ID"
            }
        ]
    }
    </script>

    <div class="toast-stack" id="toast-stack" aria-live="polite" aria-atomic="false">
        <%
            const FLASH_MESSAGES = {
                created: { type: 'success', text: 'Rencana ditambahkan.' },
                updated: { type: 'success', text: 'Perubahan disimpan.' },
                deleted: { type: 'success', text: 'Rencana dihapus.' },
                toggled: { type: 'success', text: 'Status rencana diperbarui.' },
                invalid: { type: 'error', text: 'Rencana tidak ditemukan.' },
                full: { type: 'warning', text: 'Batas rencana tercapai.' },
                restored: { type: 'success', text: 'Rencana dikembalikan.' },
                registered: { type: 'success', text: 'Akunmu berhasil dibuat — selamat datang di Rencana.' },
                revoked: { type: 'success', text: 'Sesi dihapus. Perangkat itu tidak bisa lagi mengakses akunmu.' },
                'password-changed': { type: 'success', text: 'Kata sandi berhasil diperbarui — sesi di perangkat lain diakhiri.' },
                left: { type: 'success', text: 'Kamu sudah keluar dari akun. Sampai jumpa!' },
            };
            const message = typeof flash !== 'undefined' ? FLASH_MESSAGES[flash] : undefined;
        %>
        <% if (message) { %>
        <div class="toast toast-<%= message.type %>" data-toast role="status">
            <span class="toast-dot" aria-hidden="true"></span>
            <span class="toast-text"><%= message.text %></span>
            <button type="button" class="toast-close" aria-label="Tutup pemberitahuan">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" />
                </svg>
            </button>
        </div>
        <% } %>
    </div>

    <%- include('../partials/confirm-modal') %>
    <%- include('../partials/footer') %>

    <button type="button" class="scroll-top" id="scroll-top" hidden aria-label="Kembali ke atas">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7" />
        </svg>
    </button>

    <script src="/vendor/gsap.min.js" defer></script>
    <script src="/js/spa.js?v=<%= assetVersion %>" defer></script>
    <script src="/js/app.js?v=<%= assetVersion %>" defer></script>
</body>
</html>