<%- include('partials/header') %>

<main class="content" id="main-content">
    <section class="masthead">
        <div class="masthead-copy">
            <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Buku rencana · harian</p>
            <h1 class="masthead-title">Apa rencanamu <em>hari ini?</em></h1>
            <p class="masthead-lede">Catat, selesaikan, dan rayakan langkah kecilmu — semua tersimpan aman di akunmu.</p>

            <div class="masthead-actions">
                <a class="btn btn-cta" href="/add-todo">
                    <span class="btn-label">Tambah Rencana</span>
                    <span class="btn-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </span>
                </a>

                <a class="btn btn-ghost btn-icoonly" href="/api/export" download aria-label="Unduh salinan data (JSON)" title="Unduh salinan data (JSON)">
                    <span class="btn-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
                        </svg>
                    </span>
                </a>

                <button type="button" class="btn btn-ghost btn-icoonly" id="import-btn" aria-label="Impor data dari berkas JSON" title="Impor data dari berkas JSON">
                    <span class="btn-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 21V9m0 0 4 4m-4-4-4 4M4 7V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2" />
                        </svg>
                    </span>
                </button>
                <input type="file" id="import-file" accept="application/json,.json" hidden />
            </div>
        </div>

        <% if (stats.total > 0) { %>
        <aside class="ledger" data-reveal style="--d: 0.12s">
            <div class="ledger-shell">
                <div class="ledger-core">
                    <p class="ledger-eyebrow"><span class="live-dot" aria-hidden="true"></span>Rekap hari ini</p>

                    <div class="ledger-body">
                        <div class="ledger-cell">
                            <span class="ledger-num"><strong id="stat-done"><%= stats.completed %></strong></span>
                            <span class="ledger-cap">selesai</span>
                        </div>
                        <div class="ledger-cell">
                            <span class="ledger-num"><strong id="stat-active"><%= stats.active %></strong></span>
                            <span class="ledger-cap">tersisa</span>
                        </div>
                    </div>

                    <div class="progress"
                         role="progressbar"
                         aria-label="Progres penyelesaian"
                         aria-valuemin="0"
                         aria-valuemax="100"
                         aria-valuenow="<%= stats.percent %>">
                        <span class="progress-bar" id="progress-bar" style="--p: <%= stats.percent / 100 %>"></span>
                    </div>
                    <p class="progress-caption" id="progress-text" aria-live="polite"><%= stats.completed %> dari <%= stats.total %> selesai</p>

                    <div class="all-done <%= stats.active === 0 ? '' : 'is-hidden' %>" id="all-done" role="status">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M8.2 12.4l2.6 2.6 5-5" />
                        </svg>
                        Semua selesai — mantap!
                    </div>

                    <div class="ledger-insight">
                        <p class="streak" id="ledger-streak">
                            <% if (stats.streak > 0) { %>
                            <%= stats.streak %> hari berturut-turut
                            <% } else { %>
                            Selesaikan satu rencana hari ini untuk memulai streak.
                            <% } %>
                        </p>
                        <div class="week-chart" id="week-chart" role="img" aria-label="<%= stats.weekLabel %>">
                            <% stats.week.forEach((day) => { %>
                            <div class="week-col" title="<%= day.full %>: <%= day.count %> selesai">
                                <span class="week-bar" style="--h: <%= day.bar %>" <%= day.isZero ? 'data-zero' : '' %>></span>
                                <span class="week-day"><%= day.short %></span>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </aside>
        <% } %>
    </section>

    <section class="deck" data-reveal>
        <div class="deck-shell">
            <div class="deck-core">

                <% if (stats.total > 0) { %>
                <form class="quick-add" id="quick-add" method="post" action="/" autocomplete="off">
                    <input type="text" name="name" maxlength="200"
                           placeholder="Tambahkan rencana cepat…"
                           aria-label="Rencana baru" />
                    <input type="hidden" name="category" id="quick-add-category" value="">
                    <button type="submit" class="quick-add-btn" aria-label="Tambahkan rencana">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </button>
                </form>

                <div class="toolbar">
                    <div class="search">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7" />
                            <path d="M21 21l-4.3-4.3" />
                        </svg>
                        <input type="search" id="todo-search" placeholder="Cari rencana…" autocomplete="off" aria-label="Cari rencana">
                        <button type="button" class="search-clear" id="search-clear" aria-label="Bersihkan pencarian" hidden>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                                <path d="M6 6l12 12M18 6L6 18" />
                            </svg>
                        </button>
                    </div>
                    <label class="sort-wrap">
                        <span class="sort-label" id="sort-label">Urutan</span>
                        <select id="todo-sort" aria-labelledby="sort-label">
                            <option value="newest" selected>Terbaru</option>
                            <option value="az">A–Z</option>
                            <option value="za">Z–A</option>
                        </select>
                    </label>
                    <label class="sort-wrap">
                        <span class="sort-label" id="cat-label">Kategori</span>
                        <select id="todo-category" aria-labelledby="cat-label">
                            <option value="">Semua</option>
                            <% categories.forEach((cat) => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                            <% }) %>
                        </select>
                    </label>
                    <div class="filters" role="group" aria-label="Filter status">
                        <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">Semua <span class="filter-count"><%= stats.total %></span></button>
                        <button type="button" class="filter-chip" data-filter="active" aria-pressed="false">Aktif <span class="filter-count"><%= stats.active %></span></button>
                        <button type="button" class="filter-chip" data-filter="done" aria-pressed="false">Selesai <span class="filter-count"><%= stats.completed %></span></button>
                    </div>
                </div>
                <% } %>

                <div class="todo-list" id="todo-list" aria-live="polite">
                    <% if (stats.total === 0) { %>
                    <%- include('partials/empty-list') %>
                    <% } else { %>
                    <% todos.forEach((todo) => { %>
                    <%- include('partials/todo-item', { todo }) %>
                    <% }) %>
                    <%- include('partials/empty-filtered') %>
                    <% } %>
                </div>

            </div>
        </div>
    </section>
</main>

<% if (stats.total > 0) { %>
<!-- 477 — ItemList for crawlers: the page's most important todo list. -->
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Daftar rencana",
    "itemListElement": [
        <% todos.forEach((todo, i) => { %>
        {
            "@type": "ListItem",
            "position": <%= i + 1 %>,
            "name": "<%= todo.name.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/</g, '\\u003c').replace(/>/g, '\\u003e') %>"
        }<%= i + 1 < todos.length ? ',' : '' %>
        <% }) %>
    ]
}
</script>
<% } %>