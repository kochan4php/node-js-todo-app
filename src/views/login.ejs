<%- include('partials/header') %>

<main class="content" id="main-content">
    <section class="auth-hero" data-reveal>
        <div class="auth-hero-copy">
            <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>Masuk akun</p>
            <h1 class="masthead-title">Selamat datang <em>kembali.</em></h1>
            <p class="auth-hint">Masuk untuk membuka buku rencanamu di perangkat ini — rencana, sesi, dan keamanan akunmu terurus di satu tempat.</p>

            <ul class="auth-points">
                <li>
                    <span class="auth-point-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </span>
                    Rencanamu tersinkron dan tersimpan aman di akunmu.
                </li>
                <li>
                    <span class="auth-point-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="10" width="12" height="9" rx="2" /><path d="M9 10V7a3 3 0 0 1 6 0v3" /><circle cx="12" cy="14.5" r="1.2" /></svg>
                    </span>
                    Pantau perangkat yang pernah masuk ke akunmu.
                </li>
                <li>
                    <span class="auth-point-ico" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg>
                    </span>
                    Batalkan sesi lama dan pantau riwayat masuk kapan saja.
                </li>
            </ul>
        </div>

        <div class="auth-card">
            <div class="auth-card-head">
                <span class="auth-card-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
                </span>
                <div class="auth-card-titles">
                    <p class="auth-card-title">Masuk ke Rencana</p>
                    <p class="auth-card-sub">Email &amp; kata sandi</p>
                </div>
            </div>

            <form method="post" action="/login" class="form auth-form">
                <% if (next && next !== '/') { %>
                    <input type="hidden" name="next" value="<%= next %>">
                <% } %>

                <div class="form-field <%= error ? 'is-error' : '' %>">
                    <label for="auth-email">Email</label>
                    <input type="email" id="auth-email" name="email" value="<%= old %>" autocomplete="email" inputmode="email" placeholder="kamu@email.com" required autofocus>
                </div>

                <div class="form-field <%= error ? 'is-error' : '' %>">
                    <label for="auth-password">Kata sandi</label>
                    <input type="password" id="auth-password" name="password" autocomplete="current-password" placeholder="••••••••" required>
                </div>

                <% if (error) { %>
                    <p class="form-error" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>
                        <%= error %>
                    </p>
                <% } %>

                <div class="auth-form-actions">
                    <button type="submit" class="btn btn-cta auth-submit">
                        <span class="btn-label">Masuk ke Rencana</span>
                        <span class="btn-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-4-4 4 4-4 4" /></svg>
                        </span>
                    </button>
                </div>
            </form>

            <div class="auth-card-foot">
                <p class="auth-switch">Belum punya akun? <a href="/register">Buat akun baru</a></p>
            </div>
        </div>
    </section>
</main>