{
    "name": "node-js-todo-app",
    "version": "0.4.0",
    "description": "Todo app — Express.js 5 + TypeScript + EJS, data centralized in MongoDB via Mongoose ODM.",
    "license": "Apache-2.0",
    "author": "Deo Subarno",
    "type": "module",
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node --watch src/index.ts",
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "update-deps": "pnpm update --latest",
        "prepare": "husky",
        "test": "node --test \"test/*.test.ts\"",
        "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 \"test/*.test.ts\"",
        "pretest": "pnpm typecheck",
        "pretest:coverage": "pnpm typecheck"
    },
    "keywords": [
        "todo",
        "express",
        "typescript",
        "ejs",
        "mongodb",
        "mongoose",
        "bento-ui"
    ],
    "lint-staged": {
        "*.{ts,js,cjs,mjs,json,css}": [
            "biome check --write --staged"
        ]
    },
    "dependencies": {
        "@better-auth/mongo-adapter": "^1.7.2",
        "better-auth": "^1.7.2",
        "compression": "^1.8.1",
        "ejs": "^6.0.1",
        "express": "^5.2.1",
        "express-ejs-layouts": "^2.5.1",
        "gsap": "^3.15.0",
        "helmet": "^8.3.0",
        "method-override": "^3.0.0",
        "mongoose": "^9.9.5",
        "morgan": "^1.12.0",
        "ua-parser-js": "^2.0.10"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.12",
        "@types/compression": "^1.8.1",
        "@types/ejs": "^3.1.5",
        "@types/express": "^5.0.6",
        "@types/express-ejs-layouts": "^2.5.4",
        "@types/method-override": "^3.0.0",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.4.1",
        "@types/ua-parser-js": "^0.7.39",
        "husky": "^9.1.7",
        "lint-staged": "^17.4.1",
        "mongodb-memory-server": "^11.2.0",
        "typescript": "^7.0.2"
    }
}
